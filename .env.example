# URL pública final, sem barra no fim. Necessária para canonical absoluto,
# Open Graph, sitemap.xml e referência do sitemap no robots.txt.
# Variáveis VITE_* são públicas: não insira senhas, tokens privados ou API keys.
VITE_SITE_URL=

# Opcional: ID real do Google Analytics 4 (formato G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=

# Opcional: token real da meta tag de verificação do Google Search Console.
VITE_GOOGLE_SITE_VERIFICATION=
